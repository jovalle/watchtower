# Watchtower Environment Configuration
# Copy this file to .env and fill in your values. Every setting is optional.
#
# The Plex server is not configured here. On first start, Watchtower prints a
# setup code to its logs; sign in as the Plex server owner, open /setup, enter
# the code, and pick your server. The result is saved under DATA_PATH/config.
#
# For production deployment (remote server, HTTPS, etc.):
#   Review all settings marked [PRODUCTION] below.

# ============================================
# Server Configuration
# ============================================

# Session secret for cookie signing
# Default: generated on first start and saved to DATA_PATH/config/session-secret
# SESSION_SECRET=

# Unique identifier for this Watchtower instance (used in Plex API headers)
# PLEX_CLIENT_ID=watchtower-001

# Port for the web server
# PORT=9001

# ============================================
# [PRODUCTION] Security Settings
# ============================================

# Secure cookies (requires HTTPS)
# Default: false (for local LAN/HTTP access)
# [PRODUCTION] Set to true when behind HTTPS reverse proxy
# SECURE_COOKIES=false

# ============================================
# Optional: TMDB Integration
# ============================================

# TMDB API key for movie/TV recommendations and title logos
# Get a free API key at: https://developer.themoviedb.org/
# Leave empty to disable recommendations and logo features
TMDB_API_KEY=

# ============================================
# Optional: Trakt Integration
# ============================================

# Trakt API client ID for watchlist sync
# 1. Go to: https://trakt.tv/oauth/applications
# 2. Create a new application (name: Watchtower, redirect: urn:ietf:wg:oauth:2.0:oob)
# 3. Copy the "Client ID" (NOT the Client Secret - it's not needed)
# Users configure their own Trakt username in Settings
TRAKT_CLIENT_ID=

# ============================================
# Optional: OMDb Integration
# ============================================

# OMDb API key for detailed ratings (IMDb, Rotten Tomatoes, Metacritic)
# Get a free API key (1000 requests/day) at: https://www.omdbapi.com/apikey.aspx
# Leave empty to show only Plex ratings without individual source breakdown
OMDB_API_KEY=

# ============================================
# Example Configurations
# ============================================

# --- Local Development (Docker) ---
# No settings needed:
#   (Run: docker compose up, then follow the setup code in the logs)

# --- Production with HTTPS ---
# Behind a reverse proxy like Traefik/Caddy/nginx with SSL:
#   SECURE_COOKIES=true
#   WATCHTOWER_PORT=9001

# --- Remote Docker Server (HTTP only on LAN) ---
# Accessible from other machines on your network:
#   SECURE_COOKIES=false
